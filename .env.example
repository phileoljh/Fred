FRED_API_KEY=your_fred_api_key_here

# ==========================================
# 選填設定：每日透過 Resend 自動寄送 AI 數據信件至信箱
# 若未設定或留空，send_email.py 會自動略過寄信，完全不影響網頁生成與部署
# ==========================================
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_TO=your_email@gmail.com
# 寄件者顯示名稱與信箱（選填，未綁定自訂網域時可留空，預設使用 onboarding@resend.dev）
RESEND_FROM=FRED Dashboard <onboarding@resend.dev>
